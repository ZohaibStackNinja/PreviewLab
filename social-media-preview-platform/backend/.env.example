# ---- Core ----
PORT=4000
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS (credentials included).
ORIGIN=http://localhost:3000

# ---- Database (MongoDB Atlas or local) ----
MONGODB_URI=mongodb://127.0.0.1:27017/preview-lab
# ---- Token secrets (change in production; env-only, never in the bundle) ----
SESSION_SECRET=change-me-session-secret
SHARE_TOKEN_SECRET=change-me-share-secret
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Image storage ----
# cloudinary (production) or local (dev/demo fallback without credentials)
# local (development) or cloudinary (production)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
