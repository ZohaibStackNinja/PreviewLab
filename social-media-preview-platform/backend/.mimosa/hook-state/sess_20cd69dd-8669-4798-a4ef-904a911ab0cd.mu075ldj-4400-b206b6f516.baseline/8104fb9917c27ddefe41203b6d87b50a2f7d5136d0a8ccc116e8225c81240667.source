// Runs before every test file so env.ts (imported transitively) validates.
process.env.NODE_ENV = "test";
process.env.MONGODB_URI = process.env.MONGODB_URI || "mongodb://127.0.0.1:27017/preview-lab-test";
process.env.ORIGIN = "http://localhost:3000";
process.env.STORAGE_DRIVER = "local";
process.env.LOCAL_UPLOAD_DIR = "./data/test-uploads";
process.env.SESSION_SECRET = "test-session-secret-0123456789";
process.env.SHARE_TOKEN_SECRET = "test-share-secret-0123456789";
process.env.COOKIE_SECURE = "false";
